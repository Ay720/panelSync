{
  "name": "panelsync",
  "version": "1.0.0",
  "description": "PanelSync - Smart Multi-Panel Interview Scheduling System",
  "scripts": {
    "start": "node server/src/server.js",
    "build": "cd client && npm install && npm run build",
    "dev": "npm run dev --prefix client",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm test",
    "postinstall": "cd server && npm install && cd ../client && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13"
  },
  "keywords": [
    "interview-scheduling",
    "multi-panel",
    "mern",
    "calendar-sync",
    "saas"
  ],
  "author": "",
  "license": "ISC"
}
